[{"findings":[{"scannerType":"axe","url":"http://127.0.0.1:4173/pr-preview/547/","html":"<button data-slot=\"button\" class=\"inline-flex items-ce...\">","problemShort":"elements must meet minimum color contrast ratio thresholds","problemUrl":"https://dequeuniversity.com/rules/axe/4.11/color-contrast?application=playwright","ruleId":"color-contrast","solutionShort":"ensure the contrast between foreground and background colors meets wcag 2 aa minimum contrast ratio thresholds","solutionLong":"Fix any of the following:\n  Element has insufficient color contrast of 3.26 (foreground color: #ffffff, background color: #0090ff, font size: 10.5pt (14px), font weight: normal). Expected contrast ratio of 4.5:1"}],"issue":{"state":"open","id":5795875028,"nodeId":"I_kwDONoIDbM8AAAABWXYI1A","url":"https://github.com/a11yhood/a11yhood.github.io/issues/548","title":"Accessibility issue: Elements must meet minimum color contrast ratio thresholds on /pr-preview/547/"},"pullRequest":{"id":"PR_kwDONoIDbM8AAAABHv20Lw","url":"https://github.com/a11yhood/a11yhood.github.io/pull/549","title":"[WIP] Fix accessibility issue with button color contrast"}}]
